generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Gender {
  male
  female
}

enum Role {
  manager
  admin
}

enum Provider {
  local
  google
  facebook
}

enum SerialStatus {
  Ongoing
  Ended
  Cancelled
}

enum PersonType {
  Actor
  Director
  Writer
  Producer
}

enum MovieCategory {
  Hollywood
  Independent
  Bollywood
  Korean
  Animation
}

enum FeaturedType {
  Movie
  Serial
}

enum ImageCategory {
  poster
  backdrop
  gallery
  banner
}

// ==========================================
// CORE BASE ENTITIES
// ==========================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name") @db.VarChar(255)
  lastName  String   @map("last_name") @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  gender    Gender   @default(male)
  role      Role     @default(manager)
  provider  Provider @default(local)
  image     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt

  continueWatchings ContinueWatching[]
}

model Genre {
  id      Int           @id @default(autoincrement())
  slug    String        @unique
  name    String        @unique
  movies  MovieGenre[]
  serials SerialGenre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Country {
  id      Int      @id @default(autoincrement())
  code    String   @unique // e.g. "USA", "UK", "CN"
  name    String
  movies  Movie[]
  serials Serial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Language {
  id             Int             @id @default(autoincrement())
  code           String          @unique // e.g. "en", "fa", "zh"
  name           String          @unique
  movies         Movie[]         @relation("MoviePrimaryLanguage")
  serials        Serial[]        @relation("SerialPrimaryLanguage")
  movieSubtitles MovieSubtitle[]
  movieAudios    MovieAudio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Studio {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  movies  Movie[]
  serials Serial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  name            String
  role            PersonType @default(Actor)
  image           String?
  bio             String?    @db.Text
  birthDate       DateTime?
  birthPlace      String?
  height          String?
  activeYears     String?
  socialInstagram String?
  socialTwitter   String?
  socialImdb      String?

  movieCast MovieCast[]
  movieCrew MovieCrew[]

  serialCast SerialCast[]
  serialCrew SerialCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([name])
}

model Plan {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  price       Decimal  @db.Decimal(10, 2)
  period      String
  popular     Boolean  @default(false)
  features    String[]
  downloadMax String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MOVIES & RELATED TABLES
// ==========================================

model Movie {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  title           String
  tagline         String?
  rating          Decimal       @db.Decimal(3, 1)
  votesCount      Int           @default(0)
  year            Int
  durationMinutes Int
  category        MovieCategory @default(Hollywood)
  description     String        @db.Text
  longDescription String?       @db.Text
  image           String
  backdrop        String
  trailer         String?
  budget          BigInt?
  boxOffice       BigInt?
  recognition     String?

  languageId Int
  language   Language @relation("MoviePrimaryLanguage", fields: [languageId], references: [id])

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  studioId Int?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  crew             MovieCrew[]
  genres           MovieGenre[]
  cast             MovieCast[]
  awards           MovieAward[]
  downloads        MovieDownload[]
  subtitles        MovieSubtitle[]
  audios           MovieAudio[]
  reviews          Review[]
  streamings       MovieStreaming[]
  images           MovieImage[]
  featuredItems    FeaturedItem[]
  continueWatching ContinueWatching[]

  relatedMovies  MovieRelated[]       @relation("SourceMovie")
  relatedTo      MovieRelated[]       @relation("TargetMovie")
  relatedSerials SerialRelatedMovie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([title])
  @@index([rating])
  @@index([year])
  @@index([category])
}

model MovieImage {
  id      Int           @id @default(autoincrement())
  movieId Int
  url     String
  key     String
  caption String?
  type    ImageCategory @default(gallery)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([movieId])
}

model MovieCrew {
  id       Int        @id @default(autoincrement())
  movieId  Int
  personId Int
  role     PersonType

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([personId])
}

model MovieGenre {
  movieId Int
  genreId Int

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model MovieCast {
  id        Int     @id @default(autoincrement())
  movieId   Int
  personId  Int
  role      String
  character String?

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([personId])
}

model MovieAward {
  id      Int    @id @default(autoincrement())
  movieId Int
  title   String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieDownload {
  id         Int     @id @default(autoincrement())
  movieId    Int
  quality    String
  resolution String
  sizeBytes  BigInt
  format     String
  language   String
  url        String?

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieSubtitle {
  movieId    Int
  languageId Int

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([movieId, languageId])
}

model MovieAudio {
  id         Int     @id @default(autoincrement())
  movieId    Int
  languageId Int
  details    String?

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([languageId])
}

model MovieStreaming {
  id        Int      @id @default(autoincrement())
  movieId   Int
  platform  String
  available Boolean  @default(true)
  price     Decimal? @db.Decimal(6, 2)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieRelated {
  sourceMovieId Int
  targetMovieId Int

  sourceMovie Movie @relation("SourceMovie", fields: [sourceMovieId], references: [id], onDelete: Cascade)
  targetMovie Movie @relation("TargetMovie", fields: [targetMovieId], references: [id], onDelete: Cascade)

  @@id([sourceMovieId, targetMovieId])
}

// ==========================================
// SERIALS & RELATED TABLES
// ==========================================

model Serial {
  id              Int          @id @default(autoincrement())
  slug            String       @unique
  title           String
  rating          Decimal      @db.Decimal(3, 1)
  startYear       Int
  endYear         Int?
  seasons         Int          @default(1)
  durationMinutes Int
  episodes        Int          @default(0)
  description     String       @db.Text
  image           String
  backdrop        String?
  status          SerialStatus @default(Ongoing)
  badge           String?

  languageId Int
  language   Language @relation("SerialPrimaryLanguage", fields: [languageId], references: [id])

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  studioId Int?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  genres           SerialGenre[]
  cast             SerialCast[]
  crew             SerialCrew[]
  relatedMovies    SerialRelatedMovie[]
  images           SerialImage[]
  featuredItems    FeaturedItem[]
  continueWatching ContinueWatching[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([title])
  @@index([rating])
}

model SerialCast {
  id        Int     @id @default(autoincrement())
  serialId  Int
  personId  Int
  role      String
  character String?

  serial Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([serialId])
  @@index([personId])
}

model SerialCrew {
  id       Int        @id @default(autoincrement())
  serialId Int
  personId Int
  role     PersonType

  serial Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([serialId])
  @@index([personId])
}

model SerialImage {
  id       Int           @id @default(autoincrement())
  serialId Int
  url      String
  key      String
  caption  String?
  type     ImageCategory @default(gallery)

  serial Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([serialId])
}

model SerialGenre {
  serialId Int
  genreId  Int

  serial Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([serialId, genreId])
}

model SerialRelatedMovie {
  serialId Int
  movieId  Int

  serial Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)
  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([serialId, movieId])
}

// ==========================================
// USER INTERACTIONS / REVIEWS / WATCHLIST
// ==========================================

model Review {
  id      Int      @id @default(autoincrement())
  movieId Int
  author  String
  avatar  String?
  rating  Int
  text    String   @db.Text
  date    DateTime @default(now())

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model ContinueWatching {
  id             Int    @id @default(autoincrement())
  userId         String @db.Uuid
  movieId        Int?
  serialId       Int?
  progress       Int // Percentage (0-100)
  remainingSec   Int // Seconds left
  currentSeason  Int?
  currentEpisode Int?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  serial Serial? @relation(fields: [serialId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
  @@unique([userId, serialId])
  @@index([userId])
}

model FeaturedItem {
  id     Int          @id @default(autoincrement())
  type   FeaturedType
  order  Int          @default(0)
  active Boolean      @default(true)

  movieId Int?
  movie   Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade)

  serialId Int?
  serial   Serial? @relation(fields: [serialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}
